rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function validUserProfile(uid) {
      return request.resource.data.keys().hasOnly([
        'uid', 'displayName', 'email', 'phone', 'createdAt',
        'nickname', 'username', 'hideEmail', 'hidePhone', 'photoData', 'locationSharingEnabled', 'locationPrecision', 'updatedAt'
      ])
      && request.resource.data.uid == uid
      && request.resource.data.displayName is string
      && request.resource.data.displayName.size() <= 80
      && (!('email' in request.resource.data) || request.resource.data.email is string)
      && (!('phone' in request.resource.data) || request.resource.data.phone is string)
      && (!('nickname' in request.resource.data) || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 60))
      && (!('username' in request.resource.data) || (request.resource.data.username is string && request.resource.data.username.matches('^[a-zA-Z0-9_ء-ي٠-٩]{3,20}$')))
      && (!('hideEmail' in request.resource.data) || request.resource.data.hideEmail is bool)
      && (!('hidePhone' in request.resource.data) || request.resource.data.hidePhone is bool)
      && (!('photoData' in request.resource.data) || (request.resource.data.photoData is string && request.resource.data.photoData.size() <= 220000))
      && (!('locationSharingEnabled' in request.resource.data) || request.resource.data.locationSharingEnabled is bool)
      && (!('locationPrecision' in request.resource.data) || request.resource.data.locationPrecision in ['exact', 'approx'])
      && request.resource.data.createdAt == request.time;
    }
    function validOrder() {
      return request.resource.data.keys().hasOnly([
        'uid', 'serviceId', 'category', 'accountInfo', 'amount', 'notes', 'status', 'createdAt'
      ])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.serviceId in [
        'games', 'apps', 'google', 'apple', 'mobile', 'zain', 'master',
        'earnings', 'repair', 'phones', 'vehicles', 'property', 'wallet'
      ]
      && request.resource.data.accountInfo is string
      && request.resource.data.accountInfo.size() > 0
      && request.resource.data.accountInfo.size() <= 120
      && request.resource.data.notes is string
      && request.resource.data.notes.size() <= 500
      && request.resource.data.amount is int
      && request.resource.data.amount >= 0
      && request.resource.data.status == 'pending'
      && request.resource.data.createdAt == request.time;
    }
    function validListing() {
      return request.resource.data.keys().hasOnly([
        'ownerUid', 'section', 'category', 'title', 'description', 'priceIQD',
        'quantity', 'city', 'contact', 'imagePaths', 'imageData', 'location',
        'status', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.ownerUid == request.auth.uid
      && request.resource.data.section in ['phones', 'vehicles', 'property', 'pets', 'other']
      && request.resource.data.category is string
      && request.resource.data.category.size() <= 60
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 100
      && request.resource.data.description is string
      && request.resource.data.description.size() <= 1500
      && request.resource.data.priceIQD is int
      && request.resource.data.priceIQD > 0
      && request.resource.data.quantity is int
      && request.resource.data.quantity >= 1
      && request.resource.data.quantity <= 99999
      && request.resource.data.city is string
      && request.resource.data.city.size() <= 80
      && request.resource.data.contact is string
      && request.resource.data.contact.size() <= 40
      && request.resource.data.imagePaths is list
      && request.resource.data.imagePaths.size() <= 6
      && request.resource.data.imageData is string
      && request.resource.data.imageData.size() <= 450000
      && (request.resource.data.location == null || request.resource.data.location is map)
      && request.resource.data.status == 'pending'
      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow create: if owns(uid) && validUserProfile(uid);
      allow read: if owns(uid) || isAdmin();
      allow update: if (owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phone', 'nickname', 'username', 'hideEmail',
          'hidePhone', 'photoData', 'locationSharingEnabled', 'locationPrecision', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 40))
        && (!('nickname' in request.resource.data) || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 60))
        && (!('username' in request.resource.data) || (request.resource.data.username is string && request.resource.data.username.matches('^[a-zA-Z0-9_ء-ي٠-٩]{3,20}$')))
        && (!('hideEmail' in request.resource.data) || request.resource.data.hideEmail is bool)
        && (!('hidePhone' in request.resource.data) || request.resource.data.hidePhone is bool)
        && (!('photoData' in request.resource.data) || (request.resource.data.photoData is string && request.resource.data.photoData.size() <= 220000))
        && (!('locationSharingEnabled' in request.resource.data) || request.resource.data.locationSharingEnabled is bool)
        && (!('locationPrecision' in request.resource.data) || request.resource.data.locationPrecision in ['exact', 'approx']))
        || isAdmin();
      allow delete: if isAdmin();
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && username.matches('^[a-zA-Z0-9_ء-ي٠-٩]{3,20}$');
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'type', 'subject', 'message', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 60
        && request.resource.data.type in ['suggestion', 'complaint']
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'resolved'];
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && validOrder();
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    function validProductOrder() {
      let listing = get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data;
      return request.resource.data.keys().hasOnly([
        'buyerUid', 'listingId', 'productTitle', 'unitPriceIQD', 'quantity',
        'totalIQD', 'buyerContact', 'note', 'status', 'paymentStatus',
        'paymentMethod', 'createdAt'
      ])
      && request.resource.data.buyerUid == request.auth.uid
      && request.resource.data.listingId is string
      && listing.status == 'approved'
      && request.resource.data.productTitle == listing.title
      && request.resource.data.unitPriceIQD == listing.priceIQD
      && request.resource.data.quantity is int
      && request.resource.data.quantity >= 1
      && request.resource.data.quantity <= listing.quantity
      && request.resource.data.totalIQD == listing.priceIQD * request.resource.data.quantity
      && request.resource.data.buyerContact is string
      && request.resource.data.buyerContact.size() >= 7
      && request.resource.data.buyerContact.size() <= 40
      && request.resource.data.note is string
      && request.resource.data.note.size() <= 300
      && request.resource.data.status == 'awaiting_payment'
      && request.resource.data.paymentStatus == 'not_paid'
      && request.resource.data.paymentMethod == 'superqi_qr_pending'
      && request.resource.data.createdAt == request.time;
    }

    match /productOrders/{productOrderId} {
      allow create: if signedIn() && validProductOrder();
      allow read: if isAdmin() || (signedIn() && resource.data.buyerUid == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentStatus', 'updatedAt'])
        && request.resource.data.status in ['confirmed', 'rejected']
        && request.resource.data.paymentStatus in ['confirmed', 'rejected'];
      allow delete: if isAdmin();
    }

    match /listings/{listingId} {
      allow create: if signedIn() && validListing();
      allow read: if isAdmin()
        || (resource.data.status in ['approved', 'sold_out', 'sold'])
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'category', 'title', 'description', 'priceIQD', 'city', 'contact',
            'imagePaths', 'updatedAt'
          ])
          && request.resource.data.status == resource.data.status
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1500
          && request.resource.data.priceIQD is int
          && request.resource.data.priceIQD >= 0
          && request.resource.data.category is string
          && request.resource.data.category.size() <= 60
          && request.resource.data.city is string
          && request.resource.data.city.size() <= 80
          && request.resource.data.contact is string
          && request.resource.data.contact.size() <= 40
          && request.resource.data.imagePaths is list
          && request.resource.data.imagePaths.size() <= 6
          && request.resource.data.updatedAt == request.time);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid
          && resource.data.status == 'pending');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}