rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    // Listing photos: owner-only upload, public read only after listing approval
    // is represented by the Firestore listing document. Storage rules cannot
    // safely infer listing approval without a corresponding Firestore lookup.
    match /listing-images/{uid}/{fileName} {
      allow read: if isAdmin() || signedIn() && request.auth.uid == uid;
      allow write: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin() || signedIn() && request.auth.uid == uid;
    }
    match /user-uploads/{uid}/{fileName} {
      allow read, write: if isAdmin() || signedIn() && request.auth.uid == uid;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}